# ============================================================
#  Cluster configuration – edit these IPs before running any script
#  Keep this file IDENTICAL on all 3 nodes
# ============================================================

MASTER_IP=192.168.1.100
WORKER1_IP=192.168.1.101
WORKER2_IP=192.168.1.102

MASTER_HOST=master
WORKER1_HOST=worker1
WORKER2_HOST=worker2

HADOOP_USER=hadoop
HADOOP_VERSION=3.3.6
SPARK_VERSION=3.5.1
SCALA_VERSION=2.12
JAVA_VERSION=11

HADOOP_HOME=/opt/hadoop
SPARK_HOME=/opt/spark
HADOOP_DATA=/opt/hadoop/data

# YARN resource settings (tune if your VMs have more RAM)
YARN_NODEMANAGER_MEMORY_MB=3072
YARN_NODEMANAGER_VCORES=2
YARN_SCHEDULER_MINIMUM_MB=512
YARN_SCHEDULER_MAXIMUM_MB=3072

# HDFS block and replication
DFS_REPLICATION=2
DFS_BLOCK_SIZE=67108864   # 64 MB in bytes
